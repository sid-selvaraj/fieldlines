---
interface Props {
  title: string;
  description: string;
  href: string;
  status?: string;
  image?: string;
}

const { title, description, href, status = 'Coming Soon', image } = Astro.props;
---

<a href={href} class="sim-card">
  <div class="preview" style={image ? `background-image: url('${image}'); background-size: cover; background-position: center;` : ''}>
    {!image && <span class="status-label">{status}</span>}
    {image && <span class="status-label overlay">{status}</span>}
  </div>
  <div class="body">
    <div class="card-type">Simulation</div>
    <h3>{title}</h3>
    <p>{description}</p>
  </div>
</a>

<style>
  .sim-card {
    display: block;
    background: var(--card-bg);
    border: 1px solid var(--border-card);
    border-left: 3px solid transparent;
    border-radius: 10px;
    overflow: hidden;
    text-decoration: none;
    transition: border-color 0.15s;
  }

  .sim-card:hover {
    border-left-color: var(--color-accent);
    text-decoration: none;
  }

  .preview {
    height: 140px;
    background: var(--hero-bg);
    display: flex;
    align-items: center;
    justify-content: center;
    border-bottom: 1px solid var(--border-card);
    position: relative;
  }

  .status-label {
    font-size: 10px;
    font-family: var(--font-mono);
    color: var(--text-tertiary);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .status-label.overlay {
    position: absolute;
    background: rgba(0, 0, 0, 0.5);
    color: #ffffff;
    padding: 4px 8px;
    border-radius: 4px;
    backdrop-filter: blur(4px);
  }

  .body {
    padding: 20px;
  }

  .card-type {
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 6px;
    font-family: var(--font-sans);
    font-weight: 500;
  }

  h3 {
    font-family: var(--font-serif);
    font-size: 15px;
    font-weight: normal;
    color: var(--text-primary);
    line-height: 1.4;
    margin-bottom: 8px;
  }

  p {
    font-size: 12px;
    color: var(--text-secondary);
    line-height: 1.6;
  }
</style>
