---
import { getCollection, render } from 'astro:content';
import SimulationPost from '../../layouts/SimulationPost.astro';

const { slug } = Astro.params;
const posts = await getCollection('simulations');
const post = posts.find(p => p.id === slug);

if (!post) {
  return Astro.redirect('/simulations');
}

const { Content } = await render(post);
---

<SimulationPost
  title={post.data.title}
  date={post.data.date}
  tags={post.data.tags}
>
  <Content />
</SimulationPost>
