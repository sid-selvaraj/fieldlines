---
import Base from '../../layouts/Base.astro';
import SimCard from '../../components/SimCard.astro';
import { getCollection } from 'astro:content';

const contentSims = await getCollection('simulations');
contentSims.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const staticSims = [
  {
    title: 'Particle Physics Explorer',
    description:
      'Explore the Standard Model, drag particles into Feynman diagrams, and quiz yourself on the fundamental building blocks of matter.',
    href: '/simulations/particle-physics',
    status: '⬡ Explore',
    image: 'data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 300"><defs><linearGradient id="grad1" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" style="stop-color:%235b4fa3;stop-opacity:1" /><stop offset="100%" style="stop-color:%237f77dd;stop-opacity:1" /></linearGradient></defs><rect width="400" height="300" fill="url(%23grad1)"/><circle cx="80" cy="80" r="15" fill="rgba(255,255,255,0.3)"/><circle cx="320" cy="220" r="25" fill="rgba(255,255,255,0.2)"/><circle cx="200" cy="150" r="12" fill="rgba(255,255,255,0.4)"/></svg>',
  },
  {
    title: 'LSTM Stock Price Prediction',
    description:
      'Interactive neural network model for forecasting stock prices using Long Short-Term Memory networks. Enter any stock ticker to see predictions.',
    href: '/simulations/stock-price',
    status: '⬡ Explore',
    image: 'data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 300"><defs><linearGradient id="grad2" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" style="stop-color:%23ede9ff;stop-opacity:1" /><stop offset="100%" style="stop-color:%23d4c9f5;stop-opacity:1" /></linearGradient></defs><rect width="400" height="300" fill="url(%23grad2)"/><polyline points="30,200 80,150 130,180 180,100 230,140 280,80 320,120 370,60" stroke="%237f77dd" stroke-width="2" fill="none"/><polyline points="30,210 80,160 130,190 180,110 230,150 280,90 320,130 370,70" stroke="%235b4fa3" stroke-width="2" fill="none" opacity="0.5"/></svg>',
  },
];

const allSims = [
  ...staticSims,
  ...contentSims.map(sim => ({
    title: sim.data.title,
    description: sim.data.description || 'An interactive physics simulation.',
    href: `/simulations/${sim.id}`,
    status: '⬡ Explore',
    image: undefined,
  })),
];
---

<Base title="Simulations">
  <div class="page-header">
    <h1>Simulations</h1>
    <p>
      Interactive physics simulations built to develop intuition about quantum and classical
      phenomena.
    </p>
  </div>

  <h2 class="section-label">All Simulations</h2>
  <div class="grid">
    {allSims.map(sim => (
      <SimCard title={sim.title} description={sim.description} href={sim.href} status={sim.status} image={sim.image} />
    ))}
  </div>
</Base>

<style>
  .page-header {
    padding-top: 40px;
    margin-bottom: 32px;
  }

  h1 {
    font-size: 28px;
    margin-bottom: 8px;
    color: var(--text-primary);
  }

  p {
    font-size: 14px;
    color: var(--text-secondary);
    max-width: 520px;
    line-height: 1.6;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 16px;
    padding-bottom: 48px;
  }
</style>
