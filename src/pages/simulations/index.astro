---
import Base from '../../layouts/Base.astro';
import SimCard from '../../components/SimCard.astro';
import { getCollection } from 'astro:content';

const contentSims = await getCollection('simulations');
contentSims.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const staticSims = [
  {
    title: 'Particle Physics Explorer',
    description:
      'Explore the Standard Model, drag particles into Feynman diagrams, and quiz yourself on the fundamental building blocks of matter.',
    href: '/simulations/particle-physics',
    status: '⬡ Explore',
  },
];

const allSims = [
  ...staticSims,
  ...contentSims.map(sim => ({
    title: sim.data.title,
    description: sim.data.description || 'An interactive physics simulation.',
    href: `/simulations/${sim.id}`,
    status: '⬡ Explore',
  })),
];
---

<Base title="Simulations">
  <div class="page-header">
    <h1>Simulations</h1>
    <p>
      Interactive physics simulations built to develop intuition about quantum and classical
      phenomena.
    </p>
  </div>

  <h2 class="section-label">All Simulations</h2>
  <div class="grid">
    {allSims.map(sim => (
      <SimCard title={sim.title} description={sim.description} href={sim.href} status={sim.status} />
    ))}
  </div>
</Base>

<style>
  .page-header {
    padding-top: 40px;
    margin-bottom: 32px;
  }

  h1 {
    font-size: 28px;
    margin-bottom: 8px;
    color: var(--text-primary);
  }

  p {
    font-size: 14px;
    color: var(--text-secondary);
    max-width: 520px;
    line-height: 1.6;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 16px;
    padding-bottom: 48px;
  }
</style>
